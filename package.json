{
  "name": "@voidly/mcp-email",
  "version": "2.1.1",
  "mcpName": "io.github.voidly-ai/mcp-email",
  "description": "Email inboxes for AI agents: create one with a single command, receive and read mail over MCP, send to owner-approved recipients. Mail is readable by the server; not end-to-end encrypted.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "voidly-mcp-email": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "email",
    "agent",
    "ai",
    "inbox",
    "voidmail",
    "claude",
    "llm",
    "tool",
    "messaging"
  ],
  "author": "Ai Analytics LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidly-ai/mcp-email"
  },
  "homepage": "https://voidly.ai/agent-email",
  "bugs": {
    "url": "https://github.com/voidly-ai/mcp-email/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "postal-mime": "2.7.5",
    "tweetnacl": "1.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
