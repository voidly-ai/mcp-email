  "description": "MCP server for agent email: create @voidmail.ai inboxes, send to owner-approved recipients, receive, search and manage aliases. No phone or CAPTCHA.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "voidly-mcp-email": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "email",
    "agent",
    "ai",
    "inbox",
    "voidmail",
    "claude",
    "llm",
    "tool",
    "messaging"
  ],
  "author": "Ai Analytics LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidly-ai/mcp-email"
  },
  "homepage": "https://voidly.ai/agent-email",
  "bugs": {
    "url": "https://github.com/voidly-ai/mcp-email/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
